# syntax=docker/dockerfile:1
FROM varnish:9.1@sha256:e4ad0535a84a281f0d6b09d0c59f0eb6973b82891930c87d2580170c4826927e

# Non-root exec needs a file capability to retain the Pod's IPC_LOCK grant.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap cap_ipc_lock=ep /usr/sbin/varnishd \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
