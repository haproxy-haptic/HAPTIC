# syntax=docker/dockerfile:1
FROM varnish:9.1@sha256:4c6066279af88edcdd97d35a45579c77f363e551cd9cb5597644ac856d8ebbdf

# Non-root exec needs a file capability to retain the Pod's IPC_LOCK grant.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap cap_ipc_lock=ep /usr/sbin/varnishd \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
