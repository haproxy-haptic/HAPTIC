# syntax=docker/dockerfile:1
FROM varnish:9.1@sha256:f97e894d90bccc585e5847e766696b7785c98046c29f76007f06d2e2c3228a4e

# Non-root exec needs a file capability to retain the Pod's IPC_LOCK grant.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap cap_ipc_lock=ep /usr/sbin/varnishd \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
