# syntax=docker/dockerfile:1.29
# HAPTIC SPOA hub image: layers all nine plugin shared libraries on top of
# the upstream haproxy-spoa-hub container so they're loaded at hub startup.
#
# Plugins/ is staged by CI's prep-spoa-plugins job (downloads, verifies
# upstream sha256 + cosign signatures, strips the per-arch suffix so the
# *.so glob below picks up the bare libname).

# Make/CI always override this with versions-spoa.env. The syntactically valid
# nonexistent fallback keeps BuildKit analysis warning-free but makes an
# unpinned direct build fail fast instead of silently consuming a mutable tag.
ARG SPOA_HUB_VERSION=version-must-be-supplied
FROM ghcr.io/haproxy-haptic/haproxy-spoa-hub:${SPOA_HUB_VERSION}

# Plugin runtime dependencies the upstream debian:bookworm-slim base doesn't
# carry. sso-auth links against libxmlsec1-openssl for SAML2 signature
# verification. Add others here as upstream plugins acquire native deps.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libxmlsec1-openssl \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
ARG TARGETVARIANT

COPY --chmod=0755 --from=plugins ${TARGETARCH}${TARGETVARIANT}/ /etc/haproxy-spoa-hub/plugins/
COPY --chmod=0644 versions-spoa.env /etc/haproxy-spoa-hub/versions-spoa.env
RUN . /etc/haproxy-spoa-hub/versions-spoa.env \
    && test "$(haproxy-spoa-hub --version)" = "haproxy-spoa-hub ${SPOA_HUB_VERSION#v}"

LABEL org.opencontainers.image.title="haptic-spoa-hub"
LABEL org.opencontainers.image.description="HAProxy SPOA hub bundled with HAPTIC plugins (api-gateway, coraza, external-auth, fingerprinting, maxmind, mirror, rate-limit, sso-auth)"
LABEL org.opencontainers.image.source="https://github.com/haproxy-haptic/HAPTIC"
LABEL org.opencontainers.image.licenses="Apache-2.0"
